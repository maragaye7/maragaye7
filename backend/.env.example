# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne JAMAIS committer le fichier .env reel.

# --- Dolibarr ---
DOLIBARR_BASE_URL=https://mgassistances.com/crm
DOLIBARR_API_URL=https://mgassistances.com/crm/api/index.php
DOLIBARR_API_KEY=CHANGE_ME_SECRET_DOLAPIKEY
DOLIBARR_TIMEOUT_SECONDS=10

# --- Base de donnees locale MGA API ---
DATABASE_URL=postgresql+psycopg2://mga:mga@localhost:5432/mga_api

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_SECRET_JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Liste d'origines separees par des virgules, pas de wildcard en production.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
