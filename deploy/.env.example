# Copier en .env dans ce dossier (deploy/) sur le VPS de production.
# Ne JAMAIS committer le fichier .env reel.

# --- Domaine (DNS de ce sous-domaine doit pointer vers le VPS) ---
API_DOMAIN=api.mgassistances.com

# --- PostgreSQL (base locale MGA API) ---
POSTGRES_USER=mga
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=mga_api

# --- Dolibarr ---
DOLIBARR_BASE_URL=https://mgassistances.com/crm
DOLIBARR_API_URL=https://mgassistances.com/crm/api/index.php
DOLIBARR_API_KEY=CHANGE_ME_SECRET_DOLAPIKEY
DOLIBARR_TIMEOUT_SECONDS=10

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_SECRET_JWT_AT_LEAST_32_RANDOM_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Origine(s) autorisee(s) pour l'app mobile en production. Pas de wildcard.
CORS_ALLOWED_ORIGINS=https://api.mgassistances.com

# --- App ---
ENVIRONMENT=production
LOG_LEVEL=INFO
